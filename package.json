{
  "name": "@grapecity-software/dsh-spreadjs-driver",
  "version": "1.0.0",
  "description": "SpreadJS spreadsheets for DeepSeek Harness (DSH): create, import, edit, export and screenshot .xlsx workbooks — and edit the workbook the user has open in a SpreadJS designer.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapeCityXA/dsh-plugin-spreadjs-driver.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "spreadjs",
    "spreadsheet",
    "excel",
    "xlsx",
    "plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "artifacts",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build.mjs worker",
    "typecheck": "tsc --noEmit",
    "verify:public-dependencies": "node scripts/verify-public-runtime-dependencies.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:worker": "node test/worker-smoke.mjs",
    "test:integrity": "node test/export-integrity.mjs",
    "test:tool": "node test/tool-smoke.mjs",
    "test:live": "node test/live-channel-smoke.mjs",
    "test:client": "node test/client-bridge-smoke.mjs",
    "test:confinement": "node test/sandbox-confinement.mjs",
    "test:pack": "node scripts/smoke-from-pack.mjs",
    "test:all": "pnpm run typecheck && pnpm run build && node test/worker-smoke.mjs && node test/export-integrity.mjs && node test/tool-smoke.mjs && node test/live-channel-smoke.mjs && node test/client-bridge-smoke.mjs && node test/sandbox-confinement.mjs",
    "ci": "pnpm run typecheck && pnpm run verify:public-dependencies && pnpm run build && pnpm run test:worker && pnpm run test:integrity && pnpm run test:tool && pnpm run test:live && pnpm run test:client && pnpm run test:confinement && pnpm run verify:pack && pnpm run test:pack",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "pnpm run ci"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@grapecity-software/spread-sheets": "^19.1.4",
    "@grapecity-software/spread-sheets-charts": "^19.1.4",
    "@grapecity-software/spread-sheets-datacharts-addon": "^19.1.4",
    "@grapecity-software/spread-sheets-io": "^19.1.4",
    "@grapecity-software/spread-sheets-pdf": "^19.1.4",
    "@grapecity-software/spread-sheets-pivot-addon": "^19.1.4",
    "@grapecity-software/spread-sheets-print": "^19.1.4",
    "@grapecity-software/spread-sheets-shapes": "^19.1.4",
    "@grapecity-software/spread-sheets-slicers": "^19.1.4"
  }
}

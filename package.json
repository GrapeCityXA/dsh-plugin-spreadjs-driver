{
  "name": "@grapecity-software/dsh-spreadjs-driver",
  "version": "0.1.0",
  "description": "Drive the SpreadJS Workbook supplied by the DSH web editor in the user browser.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapeCityXA/dsh-plugin-spreadjs-driver.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "spreadjs",
    "spreadsheet",
    "excel",
    "xlsx",
    "plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "templates/empty.xlsx",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify:public-dependencies": "node scripts/verify-public-runtime-dependencies.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:live": "node test/live-channel-smoke.mjs",
    "test:activation": "node test/activation.mjs",
    "test:client": "node test/client-bridge-smoke.mjs",
    "test:open": "node test/open-workbook-smoke.mjs",
    "test:lifecycle": "node test/session-lifecycle-smoke.mjs",
    "test:pack": "node scripts/smoke-from-pack.mjs",
    "test:all": "pnpm run typecheck && pnpm run build && pnpm run test:live && pnpm run test:activation && pnpm run test:client && pnpm run test:open && pnpm run test:lifecycle && pnpm run test:architecture",
    "ci": "pnpm run test:all && pnpm run verify:public-dependencies && pnpm run verify:pack && pnpm run test:pack",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "pnpm run ci",
    "test:architecture": "node test/editor-only.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
